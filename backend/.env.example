# Backend Environment Variables Blueprint - Hariom Pipe Industries Ltd
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hariom_pipes?retryWrites=true&w=majority
JWT_SECRET=your_production_super_secret_jwt_key_here_change_in_prod
JWT_EXPIRES_IN=7d
NEXT_PUBLIC_SITE_URL=https://www.hariompipes.com

